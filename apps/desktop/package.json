{
  "name": "@clawd/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The desktop app: the agent and the visualiser in one window and the tray, run from a folder.",
  "main": "dist/main.cjs",
  "scripts": {
    "bundle": "node build/bundle.mjs",
    "renderer": "node build/renderer.mjs",
    "icons": "node build/icons.mjs",
    "dev": "node build/bundle.mjs && electron . --dev-url http://localhost:3000",
    "start": "node build/renderer.mjs && node build/bundle.mjs && electron .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@clawd/agent": "workspace:*",
    "@clawd/core": "workspace:*",
    "@clawd/scene": "workspace:*",
    "zod": "^4.6.2",
    "@types/node": "^22.20.2",
    "electron": "^44.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5",
    "vitest": "^5"
  }
}
